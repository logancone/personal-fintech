{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "api",
      "type": "shell",
      "command": "python -m uvicorn backend:app --reload",
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true
    },
    {
      "label": "web",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}/frontend_test" },
      "isBackground": true
    },
    {
      "label": "dev",
      "dependsOn": ["api", "web"],
      "dependsOrder": "parallel",
      "group": { "kind": "build", "isDefault": true }
    }
  ]
}
